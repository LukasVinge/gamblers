# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "Publishable key" (sb_publishable_…) – the legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional locally. In production set it to your real URL so invite/share links are right.
# NEXT_PUBLIC_SITE_URL=https://odds-league.vercel.app

# Fixtures & club logos – free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Push notifications – generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
